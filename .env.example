# Mailgun: stores the waitlist and sends confirmation emails (see README).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.elegix.net
MAILGUN_REGION=us
MAIL_FROM="Edward from Elegix <edward@mail.elegix.net>"
# Set to yes locally so Mailgun accepts emails without delivering them.
MAILGUN_TEST_MODE=yes

# Optional: who gets a notification email on each signup (default mail@elegix.net, "off" to stop).
WAITLIST_NOTIFY_TO=

# Optional: also forward every signup as JSON (Make, Zapier, Google Sheets, ...).
WAITLIST_WEBHOOK_URL=

# Public site URL, used for metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://elegix-site.vercel.app
UNSUBSCRIBE_SECRET=
